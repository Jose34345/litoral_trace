# Assurance v1 — dedicated pilot staging variables.
# Copy to .env.assurance-pilot-staging (ignored by Git) and load real values
# from the deployment secret store. Never reuse production resources.

ASSURANCE_PILOT_STAGE_ID=pilot-01
ASSURANCE_PILOT_PORT=8001
ASSURANCE_PILOT_ORGANIZATION_ID=1001
ASSURANCE_PILOT_CONFIG_FILE=./pilot/assurance-pilot.json

# Dedicated PostgreSQL staging database. Runtime and migration owner MUST be
# separate principals and MUST NOT point to production.
ASSURANCE_PILOT_DATABASE_URL=postgresql+psycopg://pilot_runtime:CHANGE_ME@pilot-db-host/litoral_trace_pilot
ASSURANCE_PILOT_MIGRATION_DATABASE_URL=postgresql+psycopg://pilot_owner:CHANGE_ME@pilot-db-host/litoral_trace_pilot

# Dedicated private object-storage bucket/prefix. Never reuse production Vault.
ASSURANCE_PILOT_STORAGE_BUCKET_NAME=litoral-trace-assurance-pilot
ASSURANCE_PILOT_STORAGE_REGION=us-east-1
# ASSURANCE_PILOT_STORAGE_ENDPOINT_URL=https://private-s3-compatible.example
# ASSURANCE_PILOT_STORAGE_ACCESS_KEY_ID=<load-from-secret-store>
# ASSURANCE_PILOT_STORAGE_SECRET_ACCESS_KEY=<load-from-secret-store>

# Pilot-only browser origin and signing key.
ASSURANCE_PILOT_CORS_ALLOW_ORIGINS=https://pilot-staging.example.invalid
ASSURANCE_PILOT_JWT_SECRET_KEY=<set-a-dedicated-32-plus-character-secret>
