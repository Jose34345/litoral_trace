# Configuración de Base de Datos PostgreSQL / PostGIS
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/litoral_trace_db
# Legacy aliases (compatibilidad temporal):
# POSTGRES_URL=postgresql+psycopg://usuario:password@host:5432/litoral_trace_db
# DB_URL=postgresql+psycopg://usuario:password@host:5432/litoral_trace_db

# Proyecto Google Cloud Platform (GCP)
GCP_PROJECT_ID=litoral-trace-prod

# Credenciales Service Account GCP (Fallback local / dev - Opcional si usa ADC en Cloud Run)
# NUNCA hardcodear ni subir claves reales a Git
GCP_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-gcp-project","private_key_id":"key_id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sa-earthengine@your-gcp-project.iam.gserviceaccount.com"}

# Configuración de Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# Seguridad JWT y Entorno
JWT_SECRET_KEY=change_this_secret_in_production_environment_32chars
ENVIRONMENT=production
