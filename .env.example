# ============================================================================
# Litoral Trace - Environment Template
# Copy values into the deployment secret store or a local untracked .env file.
# NEVER commit real credentials.
# ============================================================================

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# PostgreSQL role separation
# ----------------------------------------------------------------------------

# Application runtime principal:
# - LOGIN
# - NOSUPERUSER
# - NOBYPASSRLS
# - must NOT own application tables
DATABASE_URL=postgresql+psycopg://runtime_user:CHANGE_ME@db-host/app_database

# Satellite worker capability principal:
# - dedicated worker capability
# - no migration ownership
# - only the narrow worker functions/grants required by the queue runtime
WORKER_DATABASE_URL=postgresql+psycopg://worker_user:CHANGE_ME@db-host/app_database

# Migration / DDL owner:
# - Alembic and controlled maintenance only
# - MUST NOT be injected into long-lived API or worker services
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_owner:CHANGE_ME@db-host/app_database

# Legacy aliases are intentionally not part of the production Compose contract.
# Keep unset unless an old local-only workflow explicitly requires them.
# POSTGRES_URL=
# DB_URL=

# ----------------------------------------------------------------------------
# Optional self-hosted PostGIS container bootstrap
# These are bootstrap/owner values for the db container only.
# Do NOT reuse them as DATABASE_URL or WORKER_DATABASE_URL credentials.
# ----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litoral_trace_db

# ----------------------------------------------------------------------------
# Test isolation
# ----------------------------------------------------------------------------
# TEST_DATABASE_URL=sqlite:///litoral_trace_test.db
# TEST_POSTGRES_DATABASE_URL=postgresql+psycopg://test_runtime:CHANGE_ME@test-db/test_database
# TEST_POSTGRES_MIGRATION_DATABASE_URL=postgresql+psycopg://test_owner:CHANGE_ME@test-db/test_database
# ENABLE_POSTGRES_TESTS=0

# ----------------------------------------------------------------------------
# JWT / authentication
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=<set-a-32-plus-character-secret-outside-repo>
JWT_ALGORITHM=HS256
JWT_ISSUER=litoral-trace-api
JWT_AUDIENCE=litoral-trace-b2b
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------------------------------
# CORS / cache
# ----------------------------------------------------------------------------
# CORS_ALLOW_ORIGINS=https://litoraltrace.com,https://www.litoraltrace.com
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Google Earth Engine / Google Cloud
# Prefer ADC / workload identity / secret manager over inline JSON.
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=<set-in-runtime>
# GEE_PROJECT_ID=<optional-override>
# GCP_SERVICE_ACCOUNT=<single-line-json-loaded-from-a-secret-store>
# GEE_SERVICE_ACCOUNT=<optional-legacy-alias>
# TEST_MODE=0

# ----------------------------------------------------------------------------
# Private S3-compatible Vault object storage
# ----------------------------------------------------------------------------
# Keep STORAGE_BACKEND unset until object storage is intentionally configured.
# Supported backend in P2.3: s3 (AWS S3, MinIO, or compatible provider).
#
# Production:
# - bucket must be private and pre-provisioned
# - prefer IAM/workload identity over static credentials
# - TLS and certificate verification are mandatory
# - never place real credentials in this file or source control
#
# Example activation:
# STORAGE_BACKEND=s3
# STORAGE_BUCKET_NAME=litoral-trace-private-vault

STORAGE_REGION=us-east-1

# Optional S3-compatible endpoint override.
# AWS S3 normally leaves this unset.
# MinIO examples:
#   TLS:  https://minio.internal:9000
#   dev:  http://minio:9000
# STORAGE_ENDPOINT_URL=

# Static credentials are optional. Prefer provider-native identity when possible.
# If one static key is configured, both ACCESS_KEY_ID and SECRET_ACCESS_KEY
# are required. SESSION_TOKEN is optional only with a complete static pair.
# STORAGE_ACCESS_KEY_ID=<load-from-secret-store>
# STORAGE_SECRET_ACCESS_KEY=<load-from-secret-store>
# STORAGE_SESSION_TOKEN=<load-from-secret-store-if-required>

# MinIO commonly requires path-style addressing.
STORAGE_FORCE_PATH_STYLE=0

# With STORAGE_ENDPOINT_URL these values must agree with its scheme.
# Production requires TLS=true and VERIFY_TLS=true.
STORAGE_USE_TLS=1
STORAGE_VERIFY_TLS=1

# Optional custom CA bundle for a private TLS endpoint.
# STORAGE_CA_BUNDLE_PATH=/run/secrets/private-ca.pem

# Bounded network behavior.
STORAGE_CONNECT_TIMEOUT_SECONDS=5
STORAGE_READ_TIMEOUT_SECONDS=60
STORAGE_MAX_RETRIES=3

# Server-generated object keys will live below this private prefix.
STORAGE_KEY_PREFIX=vault

# 25 MiB default upload ceiling for P2.3.
STORAGE_MAX_UPLOAD_BYTES=26214400

# P2.3 evidence allowlist.
STORAGE_ALLOWED_CONTENT_TYPES=application/pdf,application/json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
# SENTRY_DSN=

# ----------------------------------------------------------------------------
# Durable satellite worker
# ----------------------------------------------------------------------------
WORKERS_ENABLED=1

# Optional explicit identity. Leave empty to generate a process-specific ID.
# SATELLITE_WORKER_ID=

SATELLITE_WORKER_POLL_SECONDS=5
SATELLITE_WORKER_HEARTBEAT_SECONDS=15
SATELLITE_WORKER_STALE_RECOVERY_INTERVAL_SECONDS=30
SATELLITE_WORKER_RETRY_BASE_SECONDS=30
SATELLITE_WORKER_RETRY_MAX_SECONDS=900

# Worker Prometheus endpoint.
# In production Compose this binds inside the worker container and is exposed
# only on the internal Docker network; it must not be published to the host.
SATELLITE_METRICS_ENABLED=1
SATELLITE_METRICS_HOST=0.0.0.0
SATELLITE_METRICS_PORT=9108
SATELLITE_QUEUE_METRICS_REFRESH_SECONDS=30

# Reserved for future broker-backed worker topologies.
# WORKER_BROKER_URL=
# WORKER_RESULT_BACKEND_URL=