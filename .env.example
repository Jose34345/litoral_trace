# Entorno de ejecucion
ENVIRONMENT=development

# Base de datos canonica de aplicacion
DATABASE_URL=<set-in-runtime>
# Legacy aliases (compatibilidad temporal):
# POSTGRES_URL=<optional-legacy-alias>
# DB_URL=<optional-legacy-alias>

# Aislamiento de tests
# TEST_DATABASE_URL=sqlite:///litoral_trace_test.db
# TEST_POSTGRES_DATABASE_URL=<explicit-test-only-postgres-url>
# ENABLE_POSTGRES_TESTS=0

# JWT
JWT_SECRET_KEY=<set-a-32-plus-character-secret-outside-repo>
JWT_ALGORITHM=HS256
JWT_ISSUER=litoral-trace-api
JWT_AUDIENCE=litoral-trace-b2b
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Earth Engine / Google Cloud
GCP_PROJECT_ID=<set-in-runtime>
# GEE_PROJECT_ID=<optional-override>
# Prefer ADC o secret manager antes que pegar JSON inline en un archivo versionado.
# GCP_SERVICE_ACCOUNT=<single-line-json-loaded-from-a-secret-store>
# GEE_SERVICE_ACCOUNT=<optional-legacy-alias>
# TEST_MODE=0

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
# CORS_ALLOW_ORIGINS=http://localhost:8000,http://localhost:3000

# Storage / observabilidad / workers (reservado para futuras fases)
# STORAGE_BACKEND=
# STORAGE_BUCKET_NAME=
# STORAGE_ENDPOINT_URL=
# LOG_LEVEL=INFO
# SENTRY_DSN=
# WORKERS_ENABLED=0
# WORKER_BROKER_URL=
# WORKER_RESULT_BACKEND_URL=
